# Development: sideloaded for the developer only. No secrets here.
TEAMSFX_ENV=dev
APP_NAME_SUFFIX= (dev)
# The public https origin of the app that serves the MCP endpoint.
APP_PUBLIC_URL=__APP_PUBLIC_URL__
# The MCP endpoint Copilot calls. A dev or test environment, never a local address.
MCP_URL=__MCP_URL__
# MCP_SSO_REFERENCE_ID lives in the gitignored env/.env.dev.user: the Teams developer portal
# "Microsoft Entra SSO registration ID" (Tools > Microsoft Entra SSO client ID registration). It is
# not a credential, but it encodes the tenant id, so it stays out of the repository.
# Written by `atk provision`.
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=
