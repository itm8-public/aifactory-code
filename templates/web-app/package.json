{
  "name": "aifactory-app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
// @if spa
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/server.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsup && vite build",
// @endif
// @if !spa
    "dev": "tsx watch --env-file-if-exists=.env src/server/server.ts",
    "build": "tsc --noEmit && tsup",
// @endif
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
// @if db
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
// @endif
// @if agent
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
// @endif
// @if copilot
    "copilot:tools": "tsx scripts/copilot-tools.ts",
    "copilot:check": "tsx scripts/copilot-tools.ts --check",
// @endif
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
// @if db
    "@azure/identity": "^4.10.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.0",
// @endif
// @if spa
    "@fastify/static": "^8.2.0",
// @endif
// @if mcp
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
// @endif
    "fastify": "^5.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
// @if spa
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/miriam-libre": "^5.3.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.120.0",
// @endif
    "@types/node": "^24.0.0",
// @if spa
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
// @endif
// @if db
    "drizzle-kit": "^0.31.11",
// @endif
    "eslint": "^9.30.0",
// @if spa
    "eslint-plugin-react-hooks": "^5.2.0",
// @endif
    "globals": "^16.0.0",
// @if spa
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
// @endif
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
// @if spa
    "vite": "^7.0.0",
// @endif
    "vitest": "^3.2.0"
  }
}
