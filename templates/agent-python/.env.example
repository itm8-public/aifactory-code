# __TITLE__ (__APP__, web): the settings this agent reads. Names and local defaults only, never
# secret values. Copy to .env for local development; .env never leaves your machine.
#
# Set by the platform in Azure. Leave them empty locally:
#   APP_ENVIRONMENT (dev, test or prod), AZURE_CLIENT_ID
#   PGHOST, PGPORT, PGDATABASE, PGUSER, PGSSLMODE (Entra token, no password)
#   DB_RUNTIME_ROLES (migration job only)
#   AZURE_OPENAI_ENDPOINT and/or AZURE_AI_PROJECT_ENDPOINT
APP_ENVIRONMENT=
AZURE_CLIENT_ID=

LOG_LEVEL=info
# Optional: the public origin, e.g. https://__APP__.example.com. Empty: the forwarded host is used.
APP_PUBLIC_ORIGIN=

# Local development only: a stand-in user instead of Easy Auth. Refused when APP_ENVIRONMENT is set.
DEV_AUTH_BYPASS=true
DEV_AUTH_ROLES=App.Admin

# Local PostgreSQL from docker compose. Trusts local connections: no password.
PGHOST=localhost
PGPORT=55432
PGDATABASE=app
PGUSER=postgres
DB_POOL_MAX=5

# Azure AI Foundry. Locally you sign in with `az login`; empty means "AI not configured".
# itm8 shared platform: the Foundry project endpoint (https://<account>.services.ai.azure.com/api/projects/<project>).
AZURE_AI_PROJECT_ENDPOINT=
# Customer landing zone: set by the platform (the Foundry account or the AI gateway).
AZURE_OPENAI_ENDPOINT=
# Plain setting: the model deployment name, e.g. the GPT chat model itm8 gives you (EU deployments only).
AI_CHAT_DEPLOYMENT=
AI_REQUESTS_PER_USER_PER_HOUR=30
